{
  "title": "今年你有几天年假？\n没休完能拿多少钱？",
  "eyebrow": "条款自测 · 带薪年休假",
  "subtitle": "回答几个问题，按国家规定算出你今年应休的年假、离职时的折算，以及没休完时单位应额外支付的工资。每一个结论都标出了依据的条款。",
  "checked": "2026-10-31",
  "docs": [
    {"id": "reg", "name": "职工带薪年休假条例", "short": "条例", "issuer": "国务院令第 514 号", "effective": "2008 年 1 月 1 日起施行", "url": "https://czj.gz.gov.cn/attachment/6/6993/6993625/7862889.pdf"},
    {"id": "mea", "name": "企业职工带薪年休假实施办法", "short": "实施办法", "issuer": "人力资源社会保障部令第 1 号", "effective": "2008 年 9 月 18 日起施行", "url": "https://www.mohrss.gov.cn/xxgk2020/gzk/gz/202112/t20211228_431596.html"},
    {"id": "cq", "name": "关于贯彻《企业职工带薪年休假实施办法》有关问题的通知", "short": "重庆通知", "issuer": "渝劳社办发〔2008〕268 号", "url": "https://rlsbj.cq.gov.cn/zwgk_182/zfxxgkml/zcwj_145360/jfxzgfxwj/200902/W020230214613025972669.pdf"}
  ],
  "clauses": {
    "t2": {"doc": "reg", "ref": "第二条", "kind": "summary", "text": "机关、团体、企业、事业单位、民办非企业单位和有雇工的个体工商户等单位的职工，连续工作 1 年以上的，享受带薪年休假；年休假期间享受与正常工作期间相同的工资收入。", "hl": ["连续工作 1 年以上", "相同的工资收入"]},
    "t3": {"doc": "reg", "ref": "第三条", "kind": "summary", "text": "累计工作满 1 年不满 10 年的，年休假 5 天；满 10 年不满 20 年的，10 天；满 20 年的，15 天。国家法定休假日、休息日不计入年休假。", "hl": ["5 天", "10 天", "15 天"]},
    "t4": {"doc": "reg", "ref": "第四条", "kind": "summary", "text": "有下列情形之一的，不享受当年年休假：（一）依法享受寒暑假，且寒暑假天数多于年休假天数；（二）请事假累计 20 天以上，且单位按规定不扣工资；（三）累计工作满 1 年不满 10 年，请病假累计 2 个月以上；（四）累计工作满 10 年不满 20 年，请病假累计 3 个月以上；（五）累计工作满 20 年以上，请病假累计 4 个月以上。", "hl": ["寒暑假天数多于年休假天数", "事假累计 20 天以上，且单位按规定不扣工资", "病假累计 2 个月以上", "病假累计 3 个月以上", "病假累计 4 个月以上"]},
    "t5": {"doc": "reg", "ref": "第五条", "kind": "summary", "text": "单位根据生产、工作情况，并考虑职工本人意愿，统筹安排年休假；可以集中、分段安排，一般不跨年度，确有必要的可以跨 1 个年度。确因工作需要不能安排的，经职工本人同意可以不安排；对应休未休的天数，按职工日工资收入的 300% 支付年休假工资报酬。", "hl": ["经职工本人同意", "300%"]},
    "m3": {"doc": "mea", "ref": "第三条", "kind": "summary", "text": "职工连续工作满 12 个月以上的，享受带薪年休假。", "hl": ["连续工作满 12 个月以上"]},
    "m4": {"doc": "mea", "ref": "第四条", "kind": "summary", "text": "年休假天数按累计工作时间确定。职工在同一或者不同用人单位工作的期间，以及依照法律、行政法规或国务院规定视同工作的期间，都计为累计工作时间。", "hl": ["同一或者不同用人单位"]},
    "m5": {"doc": "mea", "ref": "第五条", "kind": "summary", "text": "职工新进用人单位且符合第三条规定的，当年度年休假天数按在本单位剩余日历天数折算：（当年度在本单位剩余日历天数 ÷ 365 天）× 职工本人全年应当享受的年休假天数。折算后不足 1 整天的部分不享受年休假。", "hl": ["（当年度在本单位剩余日历天数 ÷ 365 天）× 职工本人全年应当享受的年休假天数", "不足 1 整天的部分不享受"]},
    "m6": {"doc": "mea", "ref": "第六条", "kind": "summary", "text": "探亲假、婚丧假、产假等国家规定的假期，以及因工伤停工留薪期间，不计入年休假假期。", "hl": ["不计入年休假假期"]},
    "m7": {"doc": "mea", "ref": "第七条", "kind": "summary", "text": "职工享受的寒暑假天数多于年休假天数的，不再享受当年的年休假。因工作需要，寒暑假天数少于年休假天数的，用人单位应当安排补足。", "hl": ["安排补足"]},
    "m9": {"doc": "mea", "ref": "第九条", "kind": "summary", "text": "用人单位根据生产、工作具体情况，并考虑职工本人意愿，统筹安排年休假。确因工作需要不能安排、或者需要跨 1 个年度安排的，应当征得职工本人同意。", "hl": ["征得职工本人同意"]},
    "m10": {"doc": "mea", "ref": "第十条", "kind": "summary", "text": "单位经职工同意不安排年休假，或者安排的天数少于应休天数的，应当在本年度内对应休未休的天数，按日工资收入的 300% 支付未休年休假工资报酬，其中包含单位支付的正常工作期间工资收入。单位安排了年休假，但职工因本人原因且书面提出不休的，单位可以只支付正常工作期间的工资收入。", "hl": ["300%", "其中包含单位支付的正常工作期间工资收入", "因本人原因且书面提出不休"]},
    "m11": {"doc": "mea", "ref": "第十一条", "kind": "summary", "text": "计算未休年休假工资报酬的日工资收入，按职工本人的月工资除以月计薪天数（21.75 天）折算。月工资指支付前 12 个月剔除加班工资后的月平均工资；在本单位工作不满 12 个月的，按实际月份计算月平均工资。", "hl": ["21.75 天", "剔除加班工资"]},
    "m12": {"doc": "mea", "ref": "第十二条", "kind": "summary", "text": "解除或者终止劳动合同时，当年度未安排职工休满应休年休假的，按当年已工作时间折算应休未休天数并支付工资报酬：（当年度在本单位已过日历天数 ÷ 365 天）× 全年应当享受的年休假天数 − 当年度已安排年休假天数。折算后不足 1 整天的部分不支付；当年已安排的天数多于折算应休天数的，不再扣回。", "hl": ["（当年度在本单位已过日历天数 ÷ 365 天）× 全年应当享受的年休假天数 − 当年度已安排年休假天数", "不再扣回"]},
    "cq": {"doc": "cq", "ref": "第六点", "kind": "summary", "text": "重庆市劳动和社会保障部门的执行口径：未休年休假按日工资收入 300% 支付，其中包含正常工作期间的工资，即单位另外再支付 200%。解除或终止劳动合同时的折算天数同样另外再支付 200%。", "hl": ["另外再支付 200%"]}
  },
  "questions": [
    {"id": "cont", "short": "连续工作满 12 个月", "text": "你已经连续工作满 12 个月了吗？", "type": "yesno", "help": "从参加工作算起，中间换过单位也算。", "cite": ["t2", "m3"]},
    {"id": "years", "short": "累计工龄", "text": "你累计工作了多少年？", "type": "number", "unit": "年", "min": 0, "max": 60, "step": 0.5, "show": "cont == true", "help": "所有单位加起来，包括依法视同工作的期间。", "cite": ["m4"]},
    {"id": "vac", "short": "有没有寒暑假", "text": "你依法享受寒暑假吗？（比如学校教职工）", "type": "yesno", "show": "cont == true", "cite": ["t4", "m7"]},
    {"id": "vaclong", "short": "寒暑假是否更长", "text": "你的寒暑假天数比年假天数多吗？", "type": "yesno", "show": "vac == true", "cite": ["t4", "m7"]},
    {"id": "personal", "short": "今年事假天数", "text": "今年请事假累计多少天？", "type": "number", "unit": "天", "min": 0, "show": "cont == true", "help": "没有请过就填 0。"},
    {"id": "personalpaid", "short": "事假是否照发工资", "text": "请事假期间，单位按规定没有扣你的工资吗？", "type": "yesno", "yes": "没扣，照发", "no": "扣了", "show": "personal >= 20", "cite": ["t4"]},
    {"id": "sick", "short": "今年病假月数", "text": "今年请病假累计多少个月？", "type": "number", "unit": "个月", "min": 0, "step": 0.5, "show": "cont == true", "help": "没有请过就填 0。"},
    {"id": "isnew", "short": "是否今年入职", "text": "你是今年才入职现在这家单位的吗？", "type": "yesno", "show": "cont == true", "cite": ["m5"]},
    {"id": "join", "short": "入职日期", "text": "入职日期", "type": "date", "show": "isnew == true"},
    {"id": "scene", "short": "要算哪种情况", "text": "你想算哪种情况？", "type": "choice", "show": "cont == true", "options": [{"v": "stay", "label": "还在职：算今年没休完的"}, {"v": "leave", "label": "要离职：算离职时的折算"}]},
    {"id": "leaveDate", "short": "离职日期", "text": "劳动合同解除或终止的日期", "type": "date", "show": "scene == 'leave'", "cite": ["m12"]},
    {"id": "taken", "short": "今年已休天数", "text": "今年已经休了几天年假？", "type": "number", "unit": "天", "min": 0, "step": 0.5, "show": "cont == true", "help": "探亲假、婚丧假、产假和工伤停工留薪期都不算年假，不要填进来。", "cite": ["m6"]},
    {"id": "salary", "short": "月平均工资", "text": "前 12 个月扣掉加班费后，月平均工资是多少？", "type": "number", "unit": "元", "min": 0, "show": "cont == true", "help": "在本单位不满 12 个月的，按实际月份平均。只用来算日工资。", "cite": ["m11"]},
    {"id": "refused", "short": "是否本人书面不休", "text": "单位安排了休假，是你因为自己的原因书面提出不休的吗？", "type": "yesno", "show": "scene == 'stay'", "cite": ["m10"]}
  ],
  "vars": [
    {"id": "full", "cases": [
      {"when": "cont == false", "value": "0"},
      {"when": "years < 1", "value": "0"},
      {"when": "years < 10", "value": "5"},
      {"when": "years < 20", "value": "10"},
      {"when": "years >= 20", "value": "15"}
    ]},
    {"id": "blocked", "cases": [
      {"when": "cont == false", "value": "'cont'"},
      {"when": "vac == true && vaclong == true", "value": "'vac'"},
      {"when": "personal >= 20 && personalpaid == true", "value": "'personal'"},
      {"when": "full == 5 && sick >= 2", "value": "'sick5'"},
      {"when": "full == 10 && sick >= 3", "value": "'sick10'"},
      {"when": "full == 15 && sick >= 4", "value": "'sick15'"},
      {"when": "true", "value": "false"}
    ]},
    {"id": "entitled", "cases": [
      {"when": "blocked != false", "value": "0"},
      {"when": "isnew == true", "value": "floor(remain(join) / 365 * full)"},
      {"when": "isnew == false", "value": "full"}
    ]},
    {"id": "elapsedDays", "cases": [
      {"when": "isnew == true", "value": "days(join, leaveDate)"},
      {"when": "isnew == false", "value": "elapsed(leaveDate)"}
    ]},
    {"id": "settle", "cases": [
      {"when": "blocked != false", "value": "0"},
      {"when": "true", "value": "max(0, floor(elapsedDays / 365 * full - taken))"}
    ]},
    {"id": "unused", "cases": [
      {"when": "blocked != false", "value": "0"},
      {"when": "scene == 'leave'", "value": "settle"},
      {"when": "scene == 'stay'", "value": "max(0, entitled - taken)"}
    ]},
    {"id": "daily", "value": "salary / 21.75"},
    {"id": "extra", "cases": [
      {"when": "unused == 0", "value": "0"},
      {"when": "scene == 'stay' && refused == true", "value": "0"},
      {"when": "true", "value": "unused * daily * 2"}
    ]}
  ],
  "results": [
    {"id": "r_ok", "label": "今年能不能休年假", "type": "verdict", "cases": [
      {"when": "blocked == 'cont'", "tone": "no", "text": "暂不享受", "why": "还没有连续工作满 12 个月。", "cite": ["t2", "m3"]},
      {"when": "blocked == 'vac'", "tone": "no", "text": "今年不享受", "why": "你的寒暑假天数多于年休假天数。如果因为工作需要寒暑假反而比年假少，单位应当补足。", "cite": ["t4", "m7"]},
      {"when": "blocked == 'personal'", "tone": "no", "text": "今年不享受", "why": "今年事假累计 {personal} 天，达到 20 天以上，而且单位按规定没有扣工资。", "cite": ["t4"]},
      {"when": "blocked == 'sick5'", "tone": "no", "text": "今年不享受", "why": "累计工作满 1 年不满 10 年，今年病假累计 {sick} 个月，达到 2 个月以上。", "cite": ["t4"]},
      {"when": "blocked == 'sick10'", "tone": "no", "text": "今年不享受", "why": "累计工作满 10 年不满 20 年，今年病假累计 {sick} 个月，达到 3 个月以上。", "cite": ["t4"]},
      {"when": "blocked == 'sick15'", "tone": "no", "text": "今年不享受", "why": "累计工作满 20 年以上，今年病假累计 {sick} 个月，达到 4 个月以上。", "cite": ["t4"]},
      {"when": "full == 0", "tone": "no", "text": "暂不享受", "why": "累计工作还不满 1 年。", "cite": ["t3"]},
      {"when": "personal >= 20", "tone": "warn", "text": "可以休", "why": "事假累计 {personal} 天，但单位扣了工资，所以不影响年假。", "cite": ["t4"]},
      {"when": "true", "tone": "ok", "text": "可以休", "why": "没有出现不享受当年年假的情形。", "cite": ["t2", "t4"]}
    ]},
    {"id": "r_full", "label": "按工龄，你每年应享", "short": "每年应享", "type": "value", "unit": "天", "format": "int", "cases": [
      {"when": "cont == false", "value": "0", "why": "还没有连续工作满 12 个月。", "cite": ["t2", "m3"]},
      {"when": "years < 1", "value": "0", "why": "累计工作不满 1 年。", "cite": ["t3"]},
      {"when": "years < 10", "value": "5", "why": "累计工作 {years} 年，属于“满 1 年不满 10 年”这一档。", "cite": ["t3", "m4"]},
      {"when": "years < 20", "value": "10", "why": "累计工作 {years} 年，属于“满 10 年不满 20 年”这一档。", "cite": ["t3", "m4"]},
      {"when": "true", "value": "15", "why": "累计工作 {years} 年，属于“满 20 年”这一档。", "cite": ["t3", "m4"]}
    ]},
    {"id": "r_days", "label": "今年在这家单位应休", "short": "今年应休", "type": "value", "unit": "天", "format": "int", "headline": true, "cases": [
      {"when": "blocked != false", "value": "0", "why": "今年不享受年休假。", "cite": ["t2", "t4"]},
      {"when": "isnew == true", "value": "entitled", "why": "今年 {join} 入职，按剩余日历天数折算：{remain(join)} ÷ 365 × {full} = {round(remain(join) / 365 * full, 2)} 天，不足 1 整天的部分不享受。", "cite": ["m5"]},
      {"when": "true", "value": "entitled", "why": "就是全年应享的天数。法定节假日和休息日不计入年假。", "cite": ["t3"]}
    ]},
    {"id": "r_unused", "label": "今年还没休的", "type": "value", "unit": "天", "format": "2", "show": "scene == 'stay'", "cases": [
      {"when": "blocked != false", "value": "0", "why": "今年不享受年休假。", "cite": ["t4"]},
      {"when": "true", "value": "unused", "why": "应休 {entitled} 天 − 已休 {taken} 天。年假一般在本年度内安排；确实需要跨 1 个年度安排或者不安排的，要征得你本人同意。", "cite": ["t5", "m9"]}
    ]},
    {"id": "r_settle", "label": "离职时折算后没休的", "type": "value", "unit": "天", "format": "int", "show": "scene == 'leave'", "cases": [
      {"when": "blocked != false", "value": "0", "why": "今年不享受年休假。", "cite": ["t4"]},
      {"when": "true", "value": "settle", "why": "今年在本单位已过 {elapsedDays} 天：{elapsedDays} ÷ 365 × {full} − 已休 {taken} = {round(elapsedDays / 365 * full - taken, 2)} 天。不足 1 整天的部分不支付；已经多休的不扣回。", "cite": ["m12"]}
    ]},
    {"id": "r_daily", "label": "你的日工资（算补偿用）", "type": "value", "format": "money", "show": "unused > 0", "cases": [
      {"when": "true", "value": "daily", "why": "月平均工资 {salary|money} ÷ 21.75 天。月工资按支付前 12 个月、剔除加班工资后的平均数计算。", "cite": ["m11"]}
    ]},
    {"id": "r_extra", "label": "正常工资之外，单位还应额外支付", "short": "额外应得", "type": "value", "format": "money", "headline": true, "show": "cont == true", "cases": [
      {"when": "unused == 0", "value": "0", "why": "没有应休未休的天数。", "cite": ["m10"]},
      {"when": "scene == 'stay' && refused == true", "value": "0", "why": "单位安排了休假，你因本人原因书面提出不休，单位可以只付正常工资。", "cite": ["m10"]},
      {"when": "true", "value": "extra", "why": "{unused} 天 × 日工资 {daily|money} × 200%。规定按日工资的 300% 支付，但其中 100% 已经包含在你的正常工资里，所以额外部分是 200%。", "cite": ["m10", "cq"]}
    ]}
  ],
  "summary": [
    {"show": "scene == 'stay'", "text": "按《职工带薪年休假条例》和《企业职工带薪年休假实施办法》，我每年应享 {full} 天年假，今年在本单位应休 {entitled} 天，已休 {taken} 天，还有 {unused} 天没休。如果单位不安排、又不是我本人书面提出不休，应在正常工资之外再支付 {extra|money}。"},
    {"show": "scene == 'leave'", "text": "按《企业职工带薪年休假实施办法》第十二条，我今年离职，折算后还有 {unused} 天年假没休，单位应在正常工资之外再支付 {extra|money}。"}
  ],
  "limits": [
    "今年刚好满 10 年或 20 年工龄的，各地对“分段折算”的口径不同，这里按你填写的工龄所在档位计算。",
    "只算国家规定的法定年假。劳动合同或公司制度给了更多假期的，按约定执行。",
    "已经休过当年年假、后来又出现病假事假情形的，影响的是下一年度的年假（实施办法第八条），这里没有计算。",
    "机关、事业单位工作人员另有规定。",
    "未休年假工资报酬的追讨涉及时效等问题，以当地劳动仲裁和法院的认定为准。"
  ],
  "example": {"name": "7 月 1 日跳槽入职、累计工龄 12 年、今年还没休、月薪 21,750 元", "answers": {"cont": true, "years": 12, "vac": false, "personal": 0, "sick": 0, "isnew": true, "join": "2026-07-01", "scene": "stay", "taken": 0, "salary": 21750, "refused": false}},
